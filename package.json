{
  "name": "gaia-react-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-release-titles.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "build:no-prerender": "node scripts/check-release-titles.mjs && tsc -b && vite build",
    "check:releases": "node scripts/check-release-titles.mjs",
    "preview": "vite preview",
    "prerender": "node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix --max-warnings=0 --cache --cache-location ./node_modules/.cache/eslint .",
    "lint-dry": "eslint --max-warnings=0 .",
    "format": "prettier --write \"src/**/*.{ts,tsx,html,md,css,json}\" \"*.{html,md,json}\"",
    "lint-all": "tsc --noEmit && eslint --max-warnings=0 . && prettier --check \"src/**/*.{ts,tsx,html,md,css,json}\"",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@gaia-react/lint": "^2.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
